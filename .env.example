# ============================================================================
# Shama Abidi — Automated Clinical Pharmacy PhD AI Discovery & CRM System
# Environment Configuration (.env)
# Copy this file to `.env` and fill in your credentials for Live Server mode:
#   cp .env.example .env
# ============================================================================

# 1. PostgreSQL & Qdrant Vector DB (Self-Hosted via Docker Compose)
POSTGRES_USER=shama_admin
POSTGRES_PASSWORD=secure_local_password
POSTGRES_DB=shama_phd_intelligence
DATABASE_URL=postgresql+asyncpg://shama_admin:secure_local_password@postgres:5432/shama_phd_intelligence
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=shama_abidi_verified_publications

# 2. Free-Tier AI Models (OpenRouter API or Local Ollama)
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OLLAMA_BASE_URL=http://host.docker.internal:11434

# 3. Academic Discovery APIs (100% Free — No Paid Key Required)
OPENALEX_MAILTO=shama.abidi80@gmail.com
SEMANTIC_SCHOLAR_API_KEY=

# 4. Gmail API (OAuth 2.0 — Zero Password Storage)
GMAIL_SENDER_EMAIL=shama.abidi80@gmail.com
GMAIL_OAUTH_CLIENT_ID=your_google_cloud_oauth_client_id.apps.googleusercontent.com
GMAIL_OAUTH_CLIENT_SECRET=your_google_cloud_oauth_client_secret
GMAIL_OAUTH_REFRESH_TOKEN=your_gmail_oauth_refresh_token

# 5. WhatsApp Alert Webhook / Cloud API Credentials
# Supports Meta WhatsApp Cloud API, Twilio WhatsApp, CallMeBot, or n8n Webhook
WHATSAPP_WEBHOOK_URL=https://your-n8n-or-whatsapp-webhook-url/alert
WHATSAPP_API_TOKEN=your_whatsapp_bearer_token_optional
WHATSAPP_RECIPIENT_PHONE=+923000000000

# 6. Autonomous Worker & Security Guardrails
WORKER_CRON_INTERVAL_HOURS=24
STRICT_NO_FABRICATION=true
HUMAN_APPROVAL_REQUIRED=true
