# 1. Primary Candidate Configuration
CANDIDATE_FULL_NAME="Dr. Shama Abidi"
CANDIDATE_EMAIL="shama.abidi80@gmail.com"
WHATSAPP_RECIPIENT_PHONE="+923002460274"
OPENALEX_MAILTO="shama.abidi80@gmail.com"

# 2. OpenRouter Free-Tier AI (Classification: FREE WITH LIMITS)
# Used for research synthesis & email personalization (includes deterministic fallback if omitted)
OPENROUTER_API_KEY="your_openrouter_api_key_here"
OPENROUTER_MODEL="openrouter/free"

# 3. Official Gmail OAuth 2.0 API (Classification: REQUIRES ACCOUNT/AUTHORIZATION)
# Used ONLY for creating Gmail Drafts (`users.drafts.create`) and monitoring incoming replies.
# HARD SAFETY LOCK: Initial Email Auto-Send is strictly DISABLED.
GMAIL_OAUTH_CLIENT_ID="your_google_cloud_oauth_client_id_here"
GMAIL_OAUTH_CLIENT_SECRET="your_google_cloud_oauth_client_secret_here"
GMAIL_OAUTH_REFRESH_TOKEN="your_gmail_oauth_refresh_token_here"

# 4. Official Meta WhatsApp Business Cloud API (Classification: REQUIRES ACCOUNT/AUTHORIZATION)
# Legitimate Cloud API for sending grouped daily summaries & reply alerts to +923002460274.
# Unsafe WhatsApp Web QR-code scraping is strictly prohibited.
WHATSAPP_PHONE_NUMBER_ID="your_meta_whatsapp_phone_number_id_here"
WHATSAPP_API_TOKEN="your_meta_whatsapp_permanent_access_token_here"

# 5. Optional External Vector / Relational Database Overrides
# Defaults to persistent SQLite (`data/shama_production.db`) + Cloud JSON (`data/production_state.json`)
DATABASE_URL="sqlite:///data/shama_production.db"
QDRANT_URL=""
QDRANT_API_KEY=""
