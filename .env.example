# ============================================================================
# SHAMA ABIDI PHD SYSTEM — PRODUCTION ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to `.env` and populate with secure, rotated production values.
# NEVER commit real credentials, tokens, or private keys to source control.
# ============================================================================

# 1. Runtime Environment (development | staging | production)
ENVIRONMENT=development

# 2. Database Connection
# In Production: Must be PostgreSQL (e.g. postgresql+psycopg://user:password@host:5432/dbname)
# In Development: Leave empty to automatically use local SQLite
DATABASE_URL=

# 3. Cryptographic & JWT Authentication Secrets
# Generate 64-character random hex strings: `openssl rand -hex 32` or `python -c "import secrets; print(secrets.token_hex(32))"`
# IN PRODUCTION: Application will strictly fail startup if JWT_SECRET or SECRET_KEY is missing!
SECRET_KEY=
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 4. Initial Administrator Bootstrap Credentials
# Used only on first database initialization when no admin exists; never overwrites existing users.
INITIAL_ADMIN_EMAIL=shamaabidiphd@gmail.com
INITIAL_ADMIN_PASSWORD=

# 5. Security, CORS & Rate Limiting
# Comma-separated list of allowed origins (e.g., https://yourdomain.com,http://localhost:8000)
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_DURATION_MINUTES=15
MAX_REQUEST_SIZE_BYTES=2097152
MAX_UPLOAD_SIZE_BYTES=10485760

# 6. Email Automation Safety Locks (Default: false)
# When false: creates Gmail Drafts only; human must review and click send.
EMAIL_AUTOMATION_ENABLED=false
DAILY_SEND_CAP=50
REPLY_TO_EMAIL=shama.abidi80@gmail.com
SMTP_FROM=shamaabidiphd@gmail.com

# 7. Official Gmail OAuth 2.0 Credentials (Required for Gmail Draft creation & reply monitoring)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GMAIL_SENDER_EMAIL=shamaabidiphd@gmail.com
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# 8. OpenRouter AI Integration
# Obtain from https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# 9. WhatsApp Notifications (Meta Cloud API / Webhook)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_TOKEN=
WHATSAPP_RECIPIENT_PHONE=
WHATSAPP_WEBHOOK_URL=

# 10. Observability & Vector Search
SENTRY_DSN=
LOG_LEVEL=INFO
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=shama_abidi_verified_publications
