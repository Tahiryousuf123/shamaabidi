# ============================================================================
# SHAMA ABIDI PHD SYSTEM — PRODUCTION ENVIRONMENT CONFIGURATION (.env.example)
# Copy to `.env` and populate values. NEVER commit real secrets to Git.
# ============================================================================

# 1. Runtime Environment (development | staging | production)
ENVIRONMENT=development

# 2. Primary PostgreSQL Database (Required in Production)
# Format: postgresql+psycopg://user:password@host:5432/shama_phd_prod
DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/shama_phd_prod

# 3. Cryptographic & JWT Authentication Secrets (Generate with: openssl rand -hex 32)
SECRET_KEY=replace_with_64_char_hex_secret_key
JWT_SECRET=replace_with_64_char_hex_jwt_signing_secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_2FA_ISSUER=ShamaAbidiPhDSystem

# 4. Security, CORS & Rate Limiting
CORS_ALLOWED_ORIGINS=https://aspnetaptech-cyber.github.io,http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_PER_MINUTE=120
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_DURATION_MINUTES=15
MAX_REQUEST_SIZE_BYTES=2097152
MAX_UPLOAD_SIZE_BYTES=10485760

# 5. Safe Email System Configuration (Hard Default: EMAIL_AUTOMATION_ENABLED=false)
EMAIL_AUTOMATION_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=shama.abidi80@gmail.com
EMAIL_PASSWORD=
SMTP_FROM=shama.abidi80@gmail.com
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# 6. AI & Scholarly Discovery Providers
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENALEX_MAILTO=shama.abidi80@gmail.com

# 7. Legitimate WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_TOKEN=
WHATSAPP_RECIPIENT_PHONE=+923002460274

# 8. Observability & Error Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO
OBJECT_STORAGE_DIR=./storage/uploads
